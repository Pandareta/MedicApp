# MongoDB connection string
MONGODB_URI=mongodb+srv://<user>:<password>@cluster.example.mongodb.net/<dbname>

# App port (optional)
PORT=3004

# JWT secrets
TOKEN_SECRET_ADMIN=your_admin_secret_here
TOKEN_SECRET_DOCTOR=your_doctor_secret_here
TOKEN_SECRET_PATIENT=your_patient_secret_here

# Email (Gmail) password or SendGrid key
GMAIL_MAILS_PASS=your_gmail_app_password
SENDGRID_APIKEY=your_sendgrid_api_key

# Stripe secret key
SK_STRIPE=your_stripe_secret_key

# Optional: Google OAuth client ID
GOOGLE_CLIENT_ID=your_google_client_id
